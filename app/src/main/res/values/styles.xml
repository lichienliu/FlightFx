<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 計算機按鍵:數字鍵(淺灰底、onSurface 字) -->
    <style name="Widget.Flightfx.CalcKey" parent="Widget.Material3.Button.TonalButton">
        <item name="cornerRadius">18dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingStart">2dp</item>
        <item name="android:paddingEnd">2dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textAlignment">center</item>
        <item name="android:textAppearance">?attr/textAppearanceHeadlineSmall</item>
        <item name="android:textSize">@dimen/calc_key_text_size</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">?attr/colorSurfaceContainerHighest</item>
    </style>

    <!-- 運算子 / 退格 / 收起:藍底藍字 -->
    <style name="Widget.Flightfx.CalcKey.Operator">
        <item name="android:textColor">@color/brand_blue</item>
        <item name="backgroundTint">@color/brand_blue_container</item>
    </style>

    <!-- AC:灰底紅字(清除動作,與藍色運算子區別) -->
    <style name="Widget.Flightfx.CalcKey.Accent">
        <item name="android:textColor">@color/status_negative</item>
    </style>

    <!-- 等號:實心藍底白字 -->
    <style name="Widget.Flightfx.CalcKey.Equals">
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@color/brand_blue</item>
    </style>

    <!-- 航班類別篩選:灰軌道 + 選中藍膠囊(無描邊),直橫共用 -->
    <style name="Widget.Flightfx.FilterGroup" parent="">
        <item name="android:background">@drawable/bg_filter_track</item>
        <item name="singleSelection">true</item>
        <item name="selectionRequired">true</item>
    </style>

    <style name="Widget.Flightfx.FilterButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
        <item name="android:textColor">@color/filter_segment_text</item>
        <item name="backgroundTint">@color/filter_segment_bg</item>
        <item name="cornerRadius">18dp</item>
    </style>
</resources>
