<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- 橫向精簡標題列:標題 + 類別篩選同行,更新狀態移到最右,壓成單列高度
         (副標讓位給篩選器:rail 已標示頁面,副標資訊量最低) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/flight_title"
            android:textAppearance="?attr/textAppearanceTitleLarge" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/line_toggle"
            style="@style/Widget.Flightfx.FilterGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp">

            <Button
                android:id="@+id/filter_domestic"
                style="@style/Widget.Flightfx.FilterButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/flight_filter_domestic" />

            <Button
                android:id="@+id/filter_international"
                style="@style/Widget.Flightfx.FilterButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/flight_filter_international" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/io_toggle"
            style="@style/Widget.Flightfx.FilterGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp">

            <Button
                android:id="@+id/filter_arrival"
                style="@style/Widget.Flightfx.FilterButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/flight_filter_arrival" />

            <Button
                android:id="@+id/filter_departure"
                style="@style/Widget.Flightfx.FilterButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/flight_filter_departure" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- 預設 invisible:跟「最後更新」文字一起現身,首次成功抓到資料前不亮 -->
        <View
            android:id="@+id/live_dot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_status_dot"
            android:backgroundTint="@color/status_positive"
            android:visibility="invisible" />

        <TextView
            android:id="@+id/last_updated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?android:attr/textColorSecondary"
            tools:text="最後更新 · 14:25:30" />

        <TextView
            android:id="@+id/poll_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/flight_poll_interval"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?android:attr/textColorSecondary" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe_refresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/flight_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                app:spanCount="@integer/list_span_count"
                tools:listitem="@layout/item_flight" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/shimmer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            tools:visibility="gone">

            <include layout="@layout/view_flight_skeleton" />
        </com.facebook.shimmer.ShimmerFrameLayout>

        <TextView
            android:id="@+id/empty_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/state_empty"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?android:attr/textColorSecondary"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/error_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:id="@+id/error_icon"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_error_outline_24"
                app:tint="?android:attr/textColorSecondary" />

            <TextView
                android:id="@+id/error_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/state_error_message"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?android:attr/textColorSecondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/retry_button"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/action_retry" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
